SYSTEM_DATABASE_URL="postgresql://developer:123456@dev.blueledgers.com:6432/postgres?pgbouncer=true"
DATABASE_URL="postgresql://developer:123456@dev.blueledgers.com:6432/postgres"
SYSTEM_SCHEMA_NAME=CARMEN_SYSTEM
GOD_MODE_PASSWORD=change-me
# Optional UUID stamped into deleted_by_id on soft delete (e.g. a system/service user). Left NULL if unset.
# GOD_MODE_USER_ID=00000000-0000-0000-0000-000000000000
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
CASCADE_MAX_ROWS=5000
CASCADE_MAX_DEPTH=20
# Backend gateway login (optional). If BACKEND_API_BASE_URL is unset, only shared-secret login is shown.
BACKEND_API_BASE_URL=https://dev.blueledgers.com:4001
BACKEND_API_APP_ID=42ab2083-5dbd-47fc-bb32-3de97dc0cd89
# Dev only: skip TLS cert verification for the backend (self-signed cert on :4001). NEVER set true in production.
# BACKEND_API_INSECURE_TLS=true
# Dev/start server port (scripts read this; falls back to Next's default 3000 if unset)
PORT=3305
# Expose the platform-migrations danger zone (db:migrate:reset). Hidden and API-refused (403) unless true.
# ALLOW_DANGER_OPS=true
