{
  "name": "carmen-inventory-god-mode",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "dev": "bun run dev:local",
    "dev:local": "bun --env-file=.env.local next dev",
    "dev:prod": "bun --env-file=.env.prod next dev",
    "dev:uat": "bun --env-file=.env.uat next dev",
    "build": "next build",
    "build:bump": "bun scripts/bump.ts",
    "start": "next start",
